{
  "name": "obsidian-orca",
  "version": "0.0.1",
  "description": "A book designer that runs inside Obsidian, setting pages with fleuron.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
    "e2e": "playwright test --project=orca",
    "shots": "ORCA_E2E_DENSITY=2 playwright test --project=shots --update-snapshots=changed"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "1.7.2",
    "obsidian-launcher": "^3.2.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "fleuron": "0.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}

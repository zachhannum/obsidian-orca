{
  "name": "obsidian-orca",
  "version": "0.6.0",
  "description": "A book designer that runs inside Obsidian, setting pages with fleuron.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e-tests",
    "lint": "node scripts/lint.mjs && eslint --max-warnings 0 . && stylelint --max-warnings 0 styles.css",
    "test": "node scripts/test.mjs",
    "e2e": "playwright test --project=orca",
    "shots": "node scripts/shots.mjs",
    "film": "ORCA_E2E_DENSITY=3 playwright test --project=film",
    "version": "node version-bump.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^14.0.0",
    "obsidian": "1.7.2",
    "obsidian-launcher": "^3.2.0",
    "stylelint": "^17.15.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/css": "1.3.6",
    "@lezer/markdown": "1.7.2",
    "@readium/css": "2.0.5",
    "brotli": "1.3.3",
    "fleuron": "0.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

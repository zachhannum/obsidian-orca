---
/** A picture the screenshot spec took of Obsidian, in both schemes, with
    rings over the parts a page names. A shot can name a tablet and a phone
    picture of the same surface, and a switch under it changes the device.
    A missing picture or mark stops the build. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DeviceFrame from './DeviceFrame.astro';
import { SCHEMES, views, type Pictured, type Sidecar } from '../shot';

interface Props {
  name: string;
  alt: string;
  caption?: string;
  /** Mark ids, in the order the page's steps number them. */
  marks?: string[];
  numbered?: boolean;
  tablet?: Pictured;
  phone?: Pictured;
}

const { name, alt, caption, marks = [], numbered = false, tablet, phone } = Astro.props;

/** The device pixels the spec takes each picture at for one CSS pixel. */
const DENSITY = 2;

const LABELS = { desktop: 'Desktop', tablet: 'Tablet', phone: 'Phone' };

const pictures = import.meta.glob<{ default: ImageMetadata }>('../shots/*.png', { eager: true });
const sidecars = import.meta.glob<{ default: Sidecar }>('../shots/*.marks.json', { eager: true });
const keyed = <T,>(found: Record<string, { default: T }>, ending: string): Record<string, T> =>
  Object.fromEntries(
    Object.entries(found).map(([file, module]) => [file.slice('../shots/'.length, -ending.length), module.default]),
  );

const percent = (part: number, whole: number): string => `${String((part / whole) * 100)}%`;

const drawn = await Promise.all(
  views({ name, alt, marks, tablet, phone }, keyed(pictures, '.png'), keyed(sidecars, '.marks.json')).map(
    async (view) => {
      const width = Math.round(view.pictures.dark.width / DENSITY);
      const height = Math.round(view.pictures.dark.height / DENSITY);
      const [dark, light] = await Promise.all(
        SCHEMES.map(async (scheme) => (await getImage({ src: view.pictures[scheme], format: 'webp' })).src),
      );
      const whole = view.measured ?? { width, height };
      const crop = view.crop;
      const sizes = [`--w: ${String(width)}`, `--h: ${String(height)}`];
      if (crop !== undefined) {
        sizes.push(
          `--cx: ${String(crop.x)}`,
          `--cy: ${String(crop.y)}`,
          `--cw: ${String(crop.width)}`,
          `--ch: ${String(crop.height)}`,
        );
      }
      return {
        ...view,
        width,
        height,
        dark,
        light,
        style: sizes.join('; '),
        boxes: view.marks.map((box) => ({
          crowded: box.crowded,
          style: `left: ${percent(box.x, whole.width)}; top: ${percent(box.y, whole.height)}; width: ${percent(box.width, whole.width)}; height: ${percent(box.height, whole.height)}`,
        })),
      };
    },
  ),
);
---

<figure class="shot-figure not-content" data-phone={drawn.some((view) => view.device === 'phone') ? '' : undefined}>
  <div class="shot-desk">
    {
      drawn.map((view) => {
        const frame = (
          <div
            class={view.crop === undefined ? 'shot-frame' : 'shot-frame cropped'}
            style={view.style}
            data-width={view.width}
            data-crop-x={view.crop?.x}
            data-crop-y={view.crop?.y}
          >
            <div class="shot-canvas">
              <img class="on-dark" src={view.dark} width={view.width} height={view.height} alt={view.alt} loading="lazy" decoding="async" />
              <img class="on-light" src={view.light} width={view.width} height={view.height} alt={view.alt} loading="lazy" decoding="async" />
              {view.boxes.length > 0 && (
                <div class="shot-marks" aria-hidden="true">
                  {view.boxes.map((box, at) => (
                    <span class={box.crowded ? 'shot-mark crowded' : 'shot-mark'} style={box.style}>
                      {numbered && <span class="shot-number">{at + 1}</span>}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <button class="shot-open" type="button" aria-label="Open the whole picture" hidden />
          </div>
        );
        return (
          <div class="shot-view" data-device={view.device}>
            {view.device === 'desktop' ? frame : <DeviceFrame device={view.device}>{frame}</DeviceFrame>}
          </div>
        );
      })
    }
  </div>
  {
    drawn.length > 1 && (
      <fieldset class="shot-switch">
        <legend class="sr-only">Device</legend>
        {drawn.map((view) => (
          <>
            <input class="shot-pick sr-only" type="radio" name={`shot-${name}`} id={`shot-${name}-${view.device}`} value={view.device} />
            <label for={`shot-${name}-${view.device}`}>{LABELS[view.device]}</label>
          </>
        ))}
      </fieldset>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
  <dialog class="shot-whole" aria-label={alt}>
    <button class="shot-close" type="button" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
    <div class="shot-whole-picture"></div>
  </dialog>
</figure>

<script>
  /** The width under which a shot opens on its phone picture, as theme.css has it. */
  const PHONE = '(max-width: 30rem)';

  for (const figure of document.querySelectorAll<HTMLElement>('.shot-figure')) {
    // The stylesheet shows the right picture before this runs. Picking it
    // here gives the switch a selection for the keyboard to move.
    const picks = [...figure.querySelectorAll<HTMLInputElement>('.shot-pick')];
    if (picks.length > 0 && !picks.some((pick) => pick.checked)) {
      const opens = matchMedia(PHONE).matches && figure.dataset['phone'] !== undefined ? 'phone' : 'desktop';
      const pick = picks.find((each) => each.value === opens);
      if (pick !== undefined) pick.checked = true;
    }

    const whole = figure.querySelector<HTMLDialogElement>('.shot-whole');
    const held = whole?.querySelector<HTMLElement>('.shot-whole-picture');
    if (whole === null || whole === undefined || held === null || held === undefined) continue;
    // A tap anywhere closes it, the button included. Escape is the dialog's own.
    whole.addEventListener('click', () => {
      whole.close();
    });
    whole.addEventListener('close', () => {
      held.replaceChildren();
    });

    for (const frame of figure.querySelectorAll<HTMLElement>('.shot-frame')) {
      const open = frame.querySelector<HTMLButtonElement>('.shot-open');
      const canvas = frame.querySelector<HTMLElement>('.shot-canvas');
      if (open === null || canvas === null) continue;
      const full = Number(frame.dataset['width']);
      // A picture drawn at its own size has nothing more to open.
      new ResizeObserver(() => {
        open.hidden = frame.clientWidth >= full - 1;
      }).observe(frame);
      open.addEventListener('click', () => {
        const copy = canvas.cloneNode(true) as HTMLElement;
        for (const img of copy.querySelectorAll('img')) img.loading = 'eager';
        held.style.width = `${String(full)}px`;
        held.replaceChildren(copy);
        whole.showModal();
        whole.scrollTo(Number(frame.dataset['cropX'] ?? 0), Number(frame.dataset['cropY'] ?? 0));
      });
    }
  }
</script>

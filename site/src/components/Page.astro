---
/** One page of the sample book, as the screenshot spec rasterized it from
    the PDF. A missing page stops the build. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  n: number;
  alt: string;
  caption?: string;
}

const { n, alt, caption } = Astro.props;

/** The device pixels the spec takes each picture at for one CSS pixel. */
const DENSITY = 2;

const pages = import.meta.glob<{ default: ImageMetadata }>('../shots/pages/page-*.png', { eager: true });
const file = `../shots/pages/page-${String(n).padStart(2, '0')}.png`;
const found = pages[file]?.default;
if (found === undefined) throw new Error(`no ${file.slice(3)} in site/src`);

const width = Math.round(found.width / DENSITY);
const height = Math.round(found.height / DENSITY);
const { src } = await getImage({ src: found, format: 'webp' });
---

<figure class="shot-figure not-content">
  <div class="shot-desk">
    <div class="shot-frame shot-page" style={`max-width: ${String(width)}px; aspect-ratio: ${String(width)} / ${String(height)}`}>
      <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

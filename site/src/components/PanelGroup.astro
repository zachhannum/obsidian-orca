---
/**
 * One group of the design panel, drawn from the same table the plugin
 * draws the panel from. A row renamed, added or re-ordered in the
 * plugin moves here with no edit, and a control kind this file cannot
 * draw stops the build.
 *
 * Every control carries the design key it writes, so the script that
 * works them keeps no table of its own.
 */
import {
  GLYPHS,
  STYLE_AXES,
  atLevel,
  styleOn,
  trims,
  type Control,
  type Group,
} from '@/ui/groups';
import Icon from './Icon.astro';

interface Props {
  group: Group;
  /** What the panel shows for each key, the defaults filled in. */
  values: Record<string, string>;
  /** The keys the book note sets itself, which are the ones with a reset. */
  own: readonly string[];
  /**
   * The faces the page can be set in. The plugin offers the vault's
   * fonts; the demo offers the ones the engine carries.
   */
  faces: readonly string[];
}

const { group, values, own, faces } = Astro.props;

/**
 * The kinds this file knows. Every other one stops the build. This file
 * draws no Variant row. The demo offers only the faces the engine
 * carries, and each of those has one variant. The plugin also hides the
 * row for a family with one variant.
 */
const DRAWN = new Set([
  'font',
  'variant',
  'length',
  'count',
  'flag',
  'segment',
  'style',
  'glyph',
  'select',
  'trim',
  'level',
]);

for (const row of group.rows) {
  for (const control of row.of) {
    if (!DRAWN.has(control.kind)) {
      throw new Error(
        `the ${group.name} group has a ${control.kind} control, which the page cannot draw`
      );
    }
  }
}

/**
 * The key a control writes. A heading's key names the level it is for,
 * and the panel opens on the first level.
 */
const OPENS_AT = 1;
const keyOf = (control: Control): string | undefined =>
  control.key === undefined ? undefined : atLevel(control.key, OPENS_AT);

/** Set on a control whose key follows the level being edited. */
const leveled = (control: Control): string | undefined =>
  control.key !== undefined && control.key !== keyOf(control) ? control.key : undefined;

/** The value the design holds for a control, the default filled in. */
const set = (control: Control): string => values[keyOf(control) ?? ''] ?? '';

/** Whether the book note sets this control itself, rather than taking the default. */
const sets = (control: Control): boolean => own.includes(keyOf(control) ?? '');

/**
 * The trims a book is set at, which the panel offers by name. The
 * sample book is measured in inches, so the demo offers them in inches.
 */
const TRIMS = trims('in');

/** The words a control offers. A trim and a font name their own. */
const choicesOf = (control: Control): readonly { value: string; label: string }[] => {
  if (control.kind === 'trim') return TRIMS;
  if (control.kind === 'font') return faces.map((face) => ({ value: face, label: face }));
  return control.choices ?? [];
};
---

<div class="o-grp">
  <div class="o-gh">{group.name}</div>
  {
    group.rows
      .filter((row) => !row.of.every((control) => control.kind === 'variant'))
      .map((row) => (
      <div class={row.grid === true ? 'o-row o-grid' : 'o-row'}>
        {row.label !== '' && <span class="o-lab">{row.label}</span>}
        {row.of.map((control) => (
          <div class="o-cell">
            {(control.kind === 'select' ||
              control.kind === 'trim' ||
              control.kind === 'font') && (
              <select
                class="o-field o-grow o-pick"
                aria-label={row.label}
                data-key={keyOf(control)} data-level={leveled(control)}
                data-kind={control.kind}
              >
                {choicesOf(control).map((choice) => (
                  <option value={choice.value} selected={choice.value === set(control)}>
                    {choice.label}
                  </option>
                ))}
              </select>
            )}
            {(control.kind === 'length' || control.kind === 'count') && (
              <div class="o-num">
                <input
                  class="o-field"
                  type="text"
                  aria-label={row.label}
                  data-key={keyOf(control)}
                  data-level={leveled(control)}
                  data-kind={control.kind}
                  data-page={control.page === true ? 'in' : undefined}
                  value={set(control)}
                />
                <div class="o-step">
                  <button type="button" data-step="1" aria-label={`Increase ${row.label}`}>
                    <Icon name="up" size={12} />
                  </button>
                  <button type="button" data-step="-1" aria-label={`Decrease ${row.label}`}>
                    <Icon name="down" size={12} />
                  </button>
                </div>
              </div>
            )}
            {control.kind === 'flag' && (
              <button
                type="button"
                class="o-tog"
                data-key={keyOf(control)} data-level={leveled(control)}
                data-kind={control.kind}
                aria-label={row.label === '' ? control.said : row.label}
              />
            )}
            {control.kind === 'level' && (
              <div class="o-seg">
                {(control.choices ?? []).map((choice, at) => (
                  <button
                    type="button"
                    class={at === 0 ? 'on' : undefined}
                    data-levels={choice.value}
                  >
                    {choice.label}
                  </button>
                ))}
              </div>
            )}
            {control.kind === 'segment' && (
              <div class="o-seg">
                {choicesOf(control).map((choice) => (
                  <button
                    type="button"
                    data-key={keyOf(control)} data-level={leveled(control)}
                    data-kind={control.kind}
                    data-value={choice.value}
                  >
                    {choice.label}
                  </button>
                ))}
              </div>
            )}
            {control.kind === 'style' && (
              <div class="o-seg">
                {STYLE_AXES.map(({ axis, icon, label }) => (
                  <button
                    type="button"
                    class={styleOn(set(control), axis) ? 'on' : undefined}
                    data-key={keyOf(control)} data-level={leveled(control)}
                    data-kind={control.kind}
                    data-axis={axis}
                    aria-label={label}
                  >
                    <Icon name={icon} size={13} />
                  </button>
                ))}
              </div>
            )}
            {control.kind === 'glyph' && (
              <div class="glyphs">
                {GLYPHS.map((glyph) => (
                  <button
                    type="button"
                    class="o-field glyph"
                    data-key={keyOf(control)} data-level={leveled(control)}
                    data-kind={control.kind}
                    data-value={glyph}
                    aria-label={`Ornament ${glyph}`}
                  >
                    {glyph}
                  </button>
                ))}
              </div>
            )}
            {control.said !== undefined && row.label === '' && (
              <span class="o-said">{control.said}</span>
            )}
            {control.said !== undefined && row.label !== '' && (
              <span class="o-unit">{control.said}</span>
            )}
          </div>
        ))}
        <button
          type="button"
          class="o-reset"
          aria-label="Reset to default"
          data-reset={row.of.map(keyOf).filter((key) => key !== undefined).join(' ')}
          style={row.of.some(sets) ? undefined : 'visibility:hidden'}
        >
          <Icon name="reset" size={12} />
        </button>
      </div>
    ))
  }
</div>

<style>
  /* The controls are the panel's own fields, drawn as things a reader
     can work rather than as a picture of them. */
  .o-seg button,
  .glyph {
    font: inherit;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .o-seg button {
    height: 21px;
    min-width: 26px;
    padding: 0 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    color: var(--o-muted);
    font-size: 11.5px;
    white-space: nowrap;
  }
  .o-seg button.on {
    background: var(--o-seg-on);
    color: var(--o-text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.14);
  }
  .o-tog {
    padding: 0;
    border: 0;
    cursor: pointer;
  }
  /* A reset shows on a row the book sets, and clears it to the default. */
  .o-reset {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .o-reset:hover {
    color: var(--o-text);
  }
  .glyphs {
    display: flex;
    gap: 5px;
  }
  .glyph {
    width: 34px;
    justify-content: center;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 14px;
  }
  .glyph.on {
    box-shadow: 0 0 0 1.5px var(--o-accent);
  }
  input.o-field,
  .o-pick {
    font: inherit;
    font-size: 12px;
  }
  .o-pick {
    cursor: pointer;
    appearance: none;
  }
  /* A number field as the plugin draws it: sixty pixels of text with an
     eighteen-pixel stepper joined to its right end, a rule between the
     two arrows. */
  .o-num {
    flex: none;
  }
  .o-num input.o-field {
    width: 60px;
  }
  .o-step {
    width: 18px;
    color: var(--o-muted);
  }
  .o-step button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .o-step button + button {
    border-top: 1px solid var(--o-border);
  }
  .o-step button:first-child {
    border-top-right-radius: 6px;
  }
  .o-step button:last-child {
    border-bottom-right-radius: 6px;
  }
  .o-step button:hover {
    background: var(--o-hover);
    color: var(--o-text);
  }
  /* A cell is nothing on an ordinary row. On a grid row it stacks the
     control over the word that names it, which is the shape the margins
     take. */
  .o-cell {
    display: contents;
  }
  /* The label takes its own line, because four numbers and their
     steppers do not fit beside one at this width. */
  .o-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 18px;
    align-items: start;
    gap: 8px;
  }
  .o-grid .o-lab {
    grid-column: 1 / 3;
    grid-row: 1;
  }
  /* The cells sit two to a line, in the two columns beside the label,
     rather than flowing back under it. */
  .o-grid .o-cell:nth-of-type(odd) {
    grid-column: 1;
  }
  .o-grid .o-cell:nth-of-type(even) {
    grid-column: 2;
  }
  .o-grid .o-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .o-grid .o-reset {
    grid-column: 3;
    grid-row: 1;
  }
  .o-grid .o-unit {
    font-size: 11px;
    color: var(--o-faint);
  }
  /* A number in a grid cell fills the cell rather than keeping the
     width it has beside a label. */
  .o-grid .o-cell .o-num {
    width: 100%;
  }
  .o-grid .o-cell .o-num input.o-field {
    flex: 1;
    width: auto;
    min-width: 0;
  }
</style>

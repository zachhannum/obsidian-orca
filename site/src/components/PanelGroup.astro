---
/**
 * One group of the design panel, drawn from the same table the plugin
 * draws the panel from. A row renamed, added or re-ordered in the
 * plugin moves here with no edit, and a control kind this file cannot
 * draw stops the build.
 */
import { GLYPHS, type Control, type Group } from '@/ui/groups';
import Icon from './Icon.astro';

interface Props {
  group: Group;
  /** What the panel shows for each key, the defaults filled in. */
  values: Record<string, string>;
  /** The keys the book note sets itself, which are the ones with a reset. */
  own: readonly string[];
  /** The keys the demo drives, each with the name its buttons write. */
  driven?: Record<string, string>;
}

const { group, values, own, driven = {} } = Astro.props;

/** The kinds this file draws. Every other one stops the build. */
const DRAWN = new Set(['font', 'length', 'count', 'flag', 'segment', 'glyph', 'word', 'select']);

for (const row of group.rows) {
  if (row.grid === true) {
    throw new Error(`the ${group.name} group lays ${row.label} out in a grid, which the page cannot draw`);
  }
  for (const control of row.of) {
    if (!DRAWN.has(control.kind)) {
      throw new Error(`the ${group.name} group has a ${control.kind} control, which the page cannot draw`);
    }
  }
}

/** The word the panel shows for a control, the default filled in. */
const set = (control: Control): string => {
  const value = values[control.key ?? ''] ?? '';
  if (control.kind !== 'select') return value;
  return (control.choices ?? []).find((choice) => choice.value === value)?.label ?? value;
};

/** Whether the book note sets this control itself, rather than taking the default. */
const sets = (control: Control): boolean => own.includes(control.key ?? '');

/** The name the demo's buttons write for a control, when it drives one. */
const drives = (control: Control): string | undefined => driven[control.key ?? ''];
---

<div class="o-grp">
  <div class="o-gh">{group.name}</div>
  {
    group.rows.map((row) => (
      <div class="o-row">
        {row.label !== '' && <span class="o-lab">{row.label}</span>}
        {row.of.map((control) => (
          <Fragment>
            {control.kind === 'font' && (
              <div class={`o-field o-grow${sets(control) ? '' : ' o-def'}`}>
                <span>{set(control)}</span>
                <Icon name="down" size={12} />
              </div>
            )}
            {control.kind === 'select' && (
              <div class={`o-field o-grow${sets(control) ? '' : ' o-def'}`}>
                <span>{set(control)}</span>
                <Icon name="down" size={12} />
              </div>
            )}
            {control.kind === 'word' && (
              <div class="o-field o-grow">
                <span>{set(control)}</span>
              </div>
            )}
            {(control.kind === 'length' || control.kind === 'count') && (
              <div class="o-num">
                <div class="o-field">{set(control)}</div>
                <div class="o-step">
                  <div>
                    <Icon name="up" size={9} />
                  </div>
                  <div>
                    <Icon name="down" size={9} />
                  </div>
                </div>
              </div>
            )}
            {control.kind === 'flag' &&
              (drives(control) === undefined ? (
                <div class={`o-tog${set(control) === 'true' ? '' : ' off'}`} />
              ) : (
                <button
                  type="button"
                  class="o-tog"
                  data-set={drives(control)}
                  aria-label={row.label === '' ? control.said : row.label}
                />
              ))}
            {control.kind === 'segment' && (
              <div class="o-seg">
                {(control.choices ?? []).map((choice) =>
                  drives(control) === undefined ? (
                    <div class={set(control) === choice.value ? 'on' : undefined}>{choice.label}</div>
                  ) : (
                    <button type="button" data-set={`${drives(control)}=${choice.value}`}>
                      {choice.label}
                    </button>
                  )
                )}
              </div>
            )}
            {control.kind === 'glyph' && (
              <div class="glyphs">
                {GLYPHS.map((glyph, at) =>
                  drives(control) === undefined ? (
                    <div class={`o-field glyph${set(control) === glyph ? ' on' : ''}`}>{glyph}</div>
                  ) : (
                    <button
                      type="button"
                      class="o-field glyph"
                      data-set={`${drives(control)}=${String(at)}`}
                      aria-label={`Ornament ${glyph}`}
                    >
                      {glyph}
                    </button>
                  )
                )}
              </div>
            )}
            {control.said !== undefined && row.label === '' && <span class="o-said">{control.said}</span>}
            {control.said !== undefined && row.label !== '' && <span class="o-unit">{control.said}</span>}
          </Fragment>
        ))}
        <span class="o-reset">{row.of.some(sets) && <Icon name="reset" size={12} />}</span>
      </div>
    ))
  }
</div>

<style>
  /* The controls the demo drives are buttons, which a segment and the
     glyph picker draw as the panel's own fields. */
  .o-seg button,
  .glyph {
    font: inherit;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .o-seg button {
    height: 21px;
    min-width: 26px;
    padding: 0 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    color: var(--o-muted);
    font-size: 11.5px;
    white-space: nowrap;
  }
  .o-seg button.on {
    background: var(--o-seg-on);
    color: var(--o-text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.14);
  }
  .o-tog {
    padding: 0;
    border: 0;
    cursor: pointer;
  }
  .glyphs {
    display: flex;
    gap: 5px;
  }
  .glyph {
    width: 34px;
    justify-content: center;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 14px;
  }
  .glyph.on {
    box-shadow: 0 0 0 1.5px var(--o-accent);
  }
</style>

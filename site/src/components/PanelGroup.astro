---
/**
 * One group of the design panel, drawn from the same table the plugin
 * draws the panel from. A row renamed, added or re-ordered in the
 * plugin moves here with no edit, and a control kind this file cannot
 * draw stops the build.
 *
 * Every control carries the design key it writes, so the script that
 * works them keeps no table of its own.
 */
import { GLYPHS, atLevel, trims, type Control, type Group } from '@/ui/groups';
import Icon from './Icon.astro';

interface Props {
  group: Group;
  /** What the panel shows for each key, the defaults filled in. */
  values: Record<string, string>;
  /** The keys the book note sets itself, which are the ones with a reset. */
  own: readonly string[];
  /**
   * The faces the page can be set in. The plugin offers the vault's
   * fonts; the demo offers the ones the engine carries.
   */
  faces: readonly string[];
}

const { group, values, own, faces } = Astro.props;

/** The kinds this file draws. Every other one stops the build. */
const DRAWN = new Set([
  'font',
  'length',
  'count',
  'flag',
  'segment',
  'glyph',
  'word',
  'select',
  'trim',
  'level',
]);

for (const row of group.rows) {
  for (const control of row.of) {
    if (!DRAWN.has(control.kind)) {
      throw new Error(
        `the ${group.name} group has a ${control.kind} control, which the page cannot draw`
      );
    }
  }
}

/**
 * The key a control writes. A heading's key names the level it is for,
 * and the panel opens on the first level.
 */
const OPENS_AT = 1;
const keyOf = (control: Control): string | undefined =>
  control.key === undefined ? undefined : atLevel(control.key, OPENS_AT);

/** Set on a control whose key follows the level being edited. */
const leveled = (control: Control): string | undefined =>
  control.key !== undefined && control.key !== keyOf(control) ? control.key : undefined;

/** The value the design holds for a control, the default filled in. */
const set = (control: Control): string => values[keyOf(control) ?? ''] ?? '';

/** Whether the book note sets this control itself, rather than taking the default. */
const sets = (control: Control): boolean => own.includes(keyOf(control) ?? '');

/**
 * The trims a book is set at, which the panel offers by name. The
 * sample book is measured in inches, so the demo offers them in inches.
 */
const TRIMS = trims('in');

/** The words a control offers. A trim and a font name their own. */
const choicesOf = (control: Control): readonly { value: string; label: string }[] => {
  if (control.kind === 'trim') return TRIMS;
  if (control.kind === 'font') return faces.map((face) => ({ value: face, label: face }));
  return control.choices ?? [];
};
---

<div class="o-grp">
  <div class="o-gh">{group.name}</div>
  {
    group.rows.map((row) => (
      <div class={row.grid === true ? 'o-row o-grid' : 'o-row'}>
        {row.label !== '' && <span class="o-lab">{row.label}</span>}
        {row.of.map((control) => (
          <div class="o-cell">
            {(control.kind === 'select' ||
              control.kind === 'trim' ||
              control.kind === 'font') && (
              <select
                class="o-field o-grow o-pick"
                aria-label={row.label}
                data-key={keyOf(control)} data-level={leveled(control)}
                data-kind={control.kind}
              >
                {choicesOf(control).map((choice) => (
                  <option value={choice.value} selected={choice.value === set(control)}>
                    {choice.label}
                  </option>
                ))}
              </select>
            )}
            {(control.kind === 'word' ||
              control.kind === 'length' ||
              control.kind === 'count') && (
              <input
                class={control.kind === 'word' ? 'o-field o-grow' : 'o-field o-small'}
                type="text"
                aria-label={row.label}
                data-key={keyOf(control)} data-level={leveled(control)}
                data-kind={control.kind}
                value={set(control)}
              />
            )}
            {control.kind === 'flag' && (
              <button
                type="button"
                class="o-tog"
                data-key={keyOf(control)} data-level={leveled(control)}
                data-kind={control.kind}
                aria-label={row.label === '' ? control.said : row.label}
              />
            )}
            {control.kind === 'level' && (
              <div class="o-seg">
                {(control.choices ?? []).map((choice, at) => (
                  <button
                    type="button"
                    class={at === 0 ? 'on' : undefined}
                    data-levels={choice.value}
                  >
                    {choice.label}
                  </button>
                ))}
              </div>
            )}
            {control.kind === 'segment' && (
              <div class="o-seg">
                {choicesOf(control).map((choice) => (
                  <button
                    type="button"
                    data-key={keyOf(control)} data-level={leveled(control)}
                    data-kind={control.kind}
                    data-value={choice.value}
                  >
                    {choice.label}
                  </button>
                ))}
              </div>
            )}
            {control.kind === 'glyph' && (
              <div class="glyphs">
                {GLYPHS.map((glyph) => (
                  <button
                    type="button"
                    class="o-field glyph"
                    data-key={keyOf(control)} data-level={leveled(control)}
                    data-kind={control.kind}
                    data-value={glyph}
                    aria-label={`Ornament ${glyph}`}
                  >
                    {glyph}
                  </button>
                ))}
              </div>
            )}
            {control.said !== undefined && row.label === '' && (
              <span class="o-said">{control.said}</span>
            )}
            {control.said !== undefined && row.label !== '' && (
              <span class="o-unit">{control.said}</span>
            )}
          </div>
        ))}
        <span class="o-reset">{row.of.some(sets) && <Icon name="reset" size={12} />}</span>
      </div>
    ))
  }
</div>

<style>
  /* The controls are the panel's own fields, drawn as things a reader
     can work rather than as a picture of them. */
  .o-seg button,
  .glyph {
    font: inherit;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .o-seg button {
    height: 21px;
    min-width: 26px;
    padding: 0 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    color: var(--o-muted);
    font-size: 11.5px;
    white-space: nowrap;
  }
  .o-seg button.on {
    background: var(--o-seg-on);
    color: var(--o-text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.14);
  }
  .o-tog {
    padding: 0;
    border: 0;
    cursor: pointer;
  }
  .glyphs {
    display: flex;
    gap: 5px;
  }
  .glyph {
    width: 34px;
    justify-content: center;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 14px;
  }
  .glyph.on {
    box-shadow: 0 0 0 1.5px var(--o-accent);
  }
  input.o-field,
  .o-pick {
    font: inherit;
    font-size: 12px;
  }
  .o-pick {
    cursor: pointer;
    appearance: none;
  }
  .o-small {
    width: 76px;
    flex: none;
  }
  /* A cell is nothing on an ordinary row. On a grid row it stacks the
     control over the word that names it, which is the shape the margins
     take. */
  .o-cell {
    display: contents;
  }
  .o-grid {
    display: grid;
    grid-template-columns: 84px 1fr 1fr 18px;
    align-items: start;
    gap: 8px;
  }
  .o-grid .o-lab {
    grid-column: 1;
    grid-row: 1;
  }
  /* The cells sit two to a line, in the two columns beside the label,
     rather than flowing back under it. */
  .o-grid .o-cell:nth-of-type(odd) {
    grid-column: 2;
  }
  .o-grid .o-cell:nth-of-type(even) {
    grid-column: 3;
  }
  .o-grid .o-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .o-grid .o-reset {
    grid-column: 4;
    grid-row: 1;
  }
  .o-grid .o-unit {
    font-size: 11px;
    color: var(--o-faint);
  }
  .o-grid input.o-field {
    width: 100%;
  }
</style>

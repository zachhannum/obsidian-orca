---
import Mark from './Mark.astro';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <Mark />
  <span translate="no" aria-label={siteTitle}>oRcA</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  span {
    font-family: var(--wordmark);
    font-weight: 400;
    font-size: 25px;
    overflow: hidden;
  }
</style>

---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import bookPdf from '../shots/twenty-thousand-leagues.pdf?url';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/landing.css';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import ThemeBoot from '../components/ThemeBoot.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Reel from '../components/Reel.astro';
import titleFace from '@fontsource-variable/roboto-flex/files/roboto-flex-latin-standard-normal.woff2?url';
import bodyFace from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import uiFace from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import wordmarkFace from '../fonts/Faune-Display_Bold_Italic.woff2?url';
import { FIRST, folio } from '../scripts/flip';
import { LIP, REST } from '../scripts/sea';

const root = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${root}start/install/`;
const repo = 'https://github.com/zachhannum/obsidian-orca';
const directory = 'https://community.obsidian.md/plugins/orca';

/** One picture the page shows: where it is served, and the box it fills. */
interface Shot {
  src: string;
  width: number;
  height: number;
}

/** The device pixels the spec takes each picture at for one CSS pixel. */
const DENSITY = 2;

const shot = async (source: ImageMetadata): Promise<Shot> => {
  const drawn = await getImage({ src: source, format: 'webp' });
  return {
    src: drawn.src,
    width: Math.round(source.width / DENSITY),
    height: Math.round(source.height / DENSITY),
  };
};

/** The pages the flip-through turns, from the title page on. */
const rasterized = import.meta.glob<{ default: ImageMetadata }>('../shots/pages/page-*.png', {
  eager: true,
});
const pages: Shot[] = await Promise.all(
  Object.keys(rasterized)
    .sort()
    .map((file) => shot((rasterized[file] as { default: ImageMetadata }).default))
);

/**
 * A leaf carries a recto on its front and the verso after it on its
 * back. The book opens closed, so no page lies under the stack on the
 * left, and the last page lies under it on the right.
 */
const leaves = pages
  .slice(0, -1)
  .flatMap((front, at) => (at % 2 === 0 ? [{ front, back: pages[at + 1] as Shot }] : []));

/**
 * The specks drifting in the water. The positions are drawn from a
 * seeded generator, so a rebuild moves nothing.
 */
let seed = 20000;
const random = () => {
  seed = (seed * 1103515245 + 12345) % 2147483648;
  return seed / 2147483648;
};
const specks = Array.from({ length: 70 }, () => {
  const size = 1.4 + random() * 1.1;
  return {
    left: random() * 100,
    top: random() * 100,
    size,
    opacity: 0.05 + random() * 0.18,
    duration: 11 + random() * 9,
    delay: -random() * 20,
  };
});

/** The surface, as three paths the script moves. The markup is its resting shape. */
const waves = [
  { off: -48, lag: 1.4, kind: 'line', width: 1.2, opacity: 0.16 },
  { off: -24, lag: 0.7, kind: 'line', width: 1.4, opacity: 0.32 },
  { off: 0, lag: 0, kind: 'body', width: 0, opacity: 1 },
];
const rest = (off: number, kind: string) =>
  kind === 'line' ? `M0 ${String(REST + off)}H1440` : `M0 ${String(REST + off)}H1440V${String(LIP)}H0Z`;

/**
 * One line of the title, written with a capital for each letter drawn
 * at full width. The title is set in capitals, so the case the line is
 * written in marks the wide letters and nothing else.
 */
const widen = (line: string): string =>
  [...line]
    .map((letter) =>
      letter !== letter.toLowerCase()
        ? `<span class="wide">${letter.toLowerCase()}</span>`
        : letter
    )
    .join('');

/** The faces of the first screen. They are fetched with the page, so its words are set once. */
const FACES = [titleFace, bodyFace, uiFace, wordmarkFace];

/** The page title. The sky's copy and the sea's are both set from it. */
const title = `${widen('a boOk designEr')}<br /><i>${widen('insidE oBsidian.')}</i>`;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>orca</title>
    <meta name="description" content="A book designer that runs inside Obsidian." />
    <link rel="icon" href={`${root}favicon.svg`} />
    {FACES.map((face) => <link rel="preload" as="font" type="font/woff2" href={face} crossorigin />)}
    <ThemeBoot />
  </head>
  <body>
    <div class="page">
      <div class="sea" aria-hidden="true">
        <svg
          class="lip"
          data-sea
          viewBox={`0 0 1440 ${String(LIP)}`}
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          {
            waves.map((wave) => (
              <path
                d={rest(wave.off, wave.kind)}
                data-kind={wave.kind}
                data-off={wave.off}
                data-lag={wave.lag}
                fill={wave.kind === 'line' ? 'none' : 'var(--sea-0)'}
                stroke={wave.kind === 'line' ? 'var(--sky-text)' : 'none'}
                stroke-width={wave.width}
                opacity={wave.opacity}
              />
            ))
          }
        </svg>
        <div class="body"></div>
        <div class="glow"></div>
        {
          specks.map((speck) => (
            <span
              class="snow"
              style={`left:${String(speck.left)}%;top:${String(speck.top)}%;width:${String(speck.size)}px;height:${String(speck.size)}px;opacity:${String(speck.opacity)};animation-duration:${String(speck.duration)}s;animation-delay:${String(speck.delay)}s`}
            />
          ))
        }
      </div>

      <header>
        <a class="word" href={root}>
          <Mark width={40} height={25} />
          <span aria-label="orca">orca</span>
        </a>
        <nav>
          <a href={docs}>Docs</a>
          <a href={repo}>GitHub</a>
          <ThemeToggle />
        </nav>
      </header>

      <main>
        <section class="hero">
          <h1>
            <span set:html={title} />
            <span class="sunk" data-sea-cut aria-hidden="true" set:html={title} />
          </h1>
          <p class="lede">
            Each chapter is a Markdown note. One book note stores the book details and the design.
            Preview the typeset book and export it to PDF, all without leaving Obsidian.
          </p>
          <div class="actions">
            <a class="install" href={directory}>Install in Obsidian</a>
            <a class="quiet" href={docs}>Read the docs</a>
          </div>

          <figure class="window">
            <Reel
              scene="hero"
              eager
              alt="Orca in Obsidian: a spread of the typeset book, with the design panel beside it."
            />
            <figcaption>
              Jules Verne, Twenty Thousand Leagues Under the Sea. Chapter I, A Shifting Reef.
            </figcaption>
          </figure>
        </section>

        <section class="stack">
          <div class="said middle">
            <h2 class="sec-h">Chapters <i>are notes</i></h2>
            <p class="sec-p">
              The book note lists the chapters in reading order, as links. Its properties are
              the title, the author, the other metadata and the design.
            </p>
          </div>
          <div class="swap">
            <div class="swap-reel">
              <Reel
                scene="chapters"
                sizes="(min-width: 1016px) 936px, 100vw"
                alt="The book note in Obsidian as Markdown: each chapter of the book is a link in a list, beside Orca's navigator."
              />
            </div>
          </div>
        </section>

        <section class="stack">
          <div class="said middle">
            <h2 class="sec-h">Write, then <i>format</i></h2>
            <p class="sec-p">
              Write chapters in Markdown. Switch the pane to the preview to see the typeset book,
              open at the page you are writing.
            </p>
          </div>
          <div class="swap">
            <div class="swap-reel">
              <Reel
                scene="write"
                sizes="(min-width: 1016px) 936px, 100vw"
                alt="The typeset book in the pane the chapter was written in, with the design panel beside it."
              />
            </div>
          </div>
        </section>

        <section class="stack">
          <div class="said middle">
            <h2 class="sec-h">Design <i>in the panel</i></h2>
            <p class="sec-p">
              The design panel has a control for the trim size, the margins, the type, the
              headings and more. The preview updates with each change. Your own CSS can take precedence,
              and overrides are shown in the panel.
            </p>
          </div>
          <div class="swap">
            <div class="swap-reel">
              <Reel
                scene="design"
                sizes="(min-width: 1016px) 936px, 100vw"
                alt="Orca's design panel beside the opening of Chapter I, set with a centred title, a drop cap and a first line in small capitals."
              />
            </div>
          </div>
        </section>

        <section class="stack">
          <div class="said middle">
            <h2 class="sec-h">Advanced <i>CSS styling</i></h2>
            <p class="sec-p">
              Orca styles the book with CSS. The design panel writes CSS for you, and you can add
              your own rules by writing CSS directly. Use inspect mode to examine elements, see the CSS that styles
              it, and which rules take effect.
            </p>
          </div>
          <div class="swap">
            <div class="swap-reel">
              <Reel
                scene="css"
                sizes="(min-width: 1016px) 936px, 100vw"
                alt="Orca in Obsidian with inspect mode on: the colophon set as a centred italic block, and the panel listing the rule that sets it above the book's CSS."
              />
            </div>
          </div>
        </section>

        <section class="stack">
          <div class="said middle">
            <h2 class="sec-h">Export for <i>reading</i></h2>
            <p class="sec-p">
              Export PDFs and ePub files for distribution. Preflight shows warnings and errors before you export.
            </p>
          </div>
          <div class="swap">
            <div class="swap-reel">
              <Reel
                scene="export"
                sizes="(min-width: 1016px) 936px, 100vw"
                alt="Orca's export dialog on the sample book: preflight names a missing image and the note it is in, and the Export button is disabled."
              />
            </div>
          </div>
        </section>

        <section class="stack">
          <div class="said middle">
            <h2 class="sec-h">On a phone <i>and a tablet</i></h2>
            <p class="sec-p">
              Orca is also compatible on phones and tablets. The interface adapts for touch and smaller screens.
            </p>
          </div>
          <div class="devices">
            <div class="device device-tablet">
              <Reel
                scene="tablet"
                sizes="(min-width: 1280px) 950px, 80vw"
                alt="Orca in Obsidian on a tablet: the navigator and the design panel pinned on each side of the opening page of Chapter I."
              />
            </div>
            <div class="device device-phone">
              <Reel
                scene="phone"
                sizes="(min-width: 1280px) 260px, (min-width: 641px) 22vw, 30vw"
                alt="Orca in Obsidian on a phone: the opening page of Chapter I in the preview, with the view buttons and Export above it."
              />
            </div>
          </div>
        </section>

        <section class="stack">
          <div class="said middle">
            <h2 class="sec-h">Turn <i>the pages</i></h2>
            <p class="sec-p">
              Twenty Thousand Leagues Under the Sea, set and exported with Orca.
            </p>
          </div>
          <div
            class="flip"
            data-flip
            data-at="0"
            tabindex="0"
            role="group"
            aria-label="The sample book, a spread at a time"
          >
            <div class="book">
              <img
                class="under recto"
                src={pages.at(-1)?.src}
                width={pages.at(-1)?.width}
                height={pages.at(-1)?.height}
                alt={`Page ${String(FIRST + pages.length)} of the sample book`}
              />
              {
                leaves.map((leaf, at) => (
                  <div class="leaf" data-leaf={at}>
                    <img class="face front" src={leaf.front.src} loading="lazy" alt="" />
                    <img class="face back" src={leaf.back.src} loading="lazy" alt="" />
                  </div>
                ))
              }
            </div>
            <div class="turn">
              <button type="button" data-turn="-1" aria-label="The spread before">
                <Icon name="left" size={16} />
              </button>
              <span class="folio" data-folio aria-live="polite">{folio(0)}</span>
              <button type="button" data-turn="1" aria-label="The spread after">
                <Icon name="right" size={16} />
              </button>
            </div>
            <a class="quiet" href={bookPdf} download="Twenty Thousand Leagues Under the Sea.pdf">
              Download the whole book as a PDF
            </a>
          </div>
        </section>

        <section class="deep">
          <Mark width={64} height={40} />
          <h2 class="sec-h">Make your <i>first book</i></h2>
          <div class="actions middle">
            <a class="install" href={directory}>Install in Obsidian</a>
            <a class="quiet" href={docs}>Read the docs</a>
          </div>
        </section>
      </main>

      <footer>
        <a class="word small" href={root}>
          <Mark width={26} height={16} />
          <span aria-label="orca">orca</span>
        </a>
        <nav>
          <a href={docs}>Docs</a>
          <a href={repo}>GitHub</a>
        </nav>
      </footer>
    </div>

    <script>
      import { startReels } from '../reel/stage';
      import { startFlip } from '../scripts/flip';
      import { startSea } from '../scripts/sea';

      const sea = document.querySelector<SVGSVGElement>('[data-sea]');
      const cut = document.querySelector<HTMLElement>('[data-sea-cut]');
      if (sea !== null) startSea(sea, cut ?? undefined);
      const flip = document.querySelector<HTMLElement>('[data-flip]');
      if (flip !== null) startFlip(flip);
      startReels([...document.querySelectorAll<HTMLElement>('[data-reel]')]);
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--sky);
    color: var(--text);
    font-family: var(--body);
    overflow-x: hidden;
  }

  /* The metrics the waterline is found from. The surface has to cross
     the second line of the title, so it is placed from the title's own
     size rather than from a number of its own. */
  .page {
    --header-h: 92px;
    --hero-pad: 64px;
    --title-size: clamp(42px, 7.6vw, 110px);
    --title-leading: 0.98;
    --title-dip: 1.46;
    --gutter: 64px;
    --step: 220px;
    --sea-lip: 140px;
    --sea-top: calc(
      var(--header-h) + var(--hero-pad) + var(--title-size) * var(--title-leading) *
        var(--title-dip) - 63px
    );
    /* The line the sea module rests its surface on, measured down from
       the top of the lip. It matches REST there. */
    --sea-rest: 72px;
    position: relative;
    overflow: hidden;
  }

  .sea {
    position: absolute;
    inset-inline: 0;
    top: var(--sea-top);
    bottom: 0;
    pointer-events: none;
  }
  .sea .lip {
    position: absolute;
    inset-inline: 0;
    top: 0;
    width: 100%;
    height: var(--sea-lip);
    overflow: visible;
  }
  /* The body reaches a pixel up under the lip. The two meet on a
     fractional pixel, and a browser that rounds their edges apart shows
     a hairline of sky between them. The gradient opens on the lip's own
     colour, so the overlap does not read. */
  .sea .body {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--sea-lip) - 1px);
    bottom: 0;
    background: linear-gradient(
      to bottom,
      var(--sea-0),
      var(--sea-1) 30%,
      var(--sea-2) 70%,
      var(--sea-3)
    );
  }
  /* The light the surface lets through, over the window in the hero. It
     is brightest at its top, so it fades in there rather than starting
     on a hard edge under the waves. */
  .sea .glow {
    position: absolute;
    inset-inline: 0;
    top: 80px;
    height: 1100px;
    background: radial-gradient(
      ellipse 70% 60% at 50% 0%,
      color-mix(in srgb, var(--accent) 8%, transparent),
      transparent 70%
    );
    mask-image: linear-gradient(to bottom, transparent, #000 240px);
  }
  .sea .snow {
    /* The specks drift in the water, not over the sky. */
    margin-top: var(--sea-lip);
  }

  header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--header-h);
    padding-inline: var(--gutter);
    color: var(--sky-text);
  }
  .word {
    display: flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }
  .word span {
    font-family: var(--wordmark);
    font-style: italic;
    font-weight: 700;
    font-size: 30px;
  }
  /* The footer's mark is the reading colour, so it is one flat white on
     the dark scheme and one flat black on the light one. */
  .word.small {
    color: var(--text);
  }
  .word.small span {
    font-size: 18px;
  }
  header nav {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: var(--ui);
    font-size: 14px;
    color: var(--sky-muted);
  }
  header nav a,
  footer nav a {
    color: inherit;
    text-decoration: none;
  }
  header nav a:hover,
  footer nav a:hover {
    color: var(--sky-text);
  }
  header :global(.theme-toggle) {
    color: var(--sky-muted);
  }
  header :global(.theme-toggle:hover) {
    color: var(--sky-text);
  }

  main {
    position: relative;
  }

  .hero {
    position: relative;
    padding: var(--hero-pad) var(--gutter) 0;
  }
  /* The title is set twice, in the sky's reading colour and the sea's,
     and the sea's copy is clipped to the water. The module moves that
     clip with the surface. */
  h1 {
    position: relative;
    margin: 0;
    font-family: var(--title);
    font-size: var(--title-size);
    line-height: var(--title-leading);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--sky-text);
  }
  /* The sea's copy is clipped to its own box, and a slanted letter at
     the start of a line leans out past the box's left edge. The box
     reaches left by that much, and the padding puts the letters back. */
  h1 .sunk {
    position: absolute;
    inset: 0 0 0 -0.2em;
    padding-inline-start: 0.2em;
    color: var(--text);
    /* The surface before the module runs, and the surface with the page
       read without scripts: the rest line, level. */
    clip-path: inset(
      calc(var(--sea-top) + var(--sea-rest) - var(--header-h) - var(--hero-pad)) 0 0 0
    );
    user-select: none;
  }
  /* Both copies of the title are written in, so their letters carry no
     scope class and the selector reaches them globally. The h1 ahead of
     it is scoped, so the rule stays on this page. */
  /* The face slants and widens on axes of its own. The settings are
     not inherited as parts, so every letter restates both. */
  h1,
  h1 :global(*) {
    font-variation-settings:
      'wdth' var(--wdth, 60),
      'slnt' var(--slnt, 0);
  }
  h1 :global(i) {
    font-style: normal;
    --slnt: -10;
  }
  h1 :global(.wide) {
    --wdth: 150;
  }
  .lede {
    margin: 34px 0 0;
    max-width: 35rem;
    font-size: 20px;
    line-height: 1.6;
    color: var(--muted);
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 32px;
    font-family: var(--ui);
  }
  .actions.middle {
    justify-content: center;
  }
  .install {
    font-size: 15px;
    font-weight: 600;
    padding: 13px 22px;
    border-radius: 6px;
    background: var(--button);
    color: var(--button-text);
    text-decoration: none;
  }
  .quiet {
    font-size: 15px;
    font-weight: 500;
    padding-bottom: 2px;
    color: var(--text);
    border-bottom: 1px solid var(--text);
    text-decoration: none;
  }

  .window {
    position: relative;
    margin: 64px auto 0;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }
  .on-light {
    display: none;
  }
  :global(:root[data-theme='light']) .on-dark {
    display: none;
  }
  :global(:root[data-theme='light']) .on-light {
    display: block;
  }
  figcaption {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--faint);
    text-align: center;
  }

  section {
    position: relative;
  }
  section + section {
    margin-top: var(--step);
  }
  .said {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 29rem;
  }
  .said.middle {
    align-items: center;
    text-align: center;
  }
  .said.middle .sec-p {
    max-width: 40rem;
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding-inline: var(--gutter);
  }

  .swap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .swap-reel {
    width: 100%;
    max-width: 936px;
  }

  /* The phone stands in front of the tablet's right edge, and a little
     lower. Each frame's measures are shares of the section's width, so
     the two keep their shapes at every width. */
  .devices {
    position: relative;
    width: 100%;
    max-width: 1160px;
    padding-bottom: 4%;
  }
  .device {
    position: relative;
    background: #0b0c0f;
    box-shadow:
      0 0 0 1px #3a3d45,
      inset 0 0 0 2px #1d1f24,
      0 40px 80px -30px rgba(0, 0, 0, 0.7);
    --reel-shadow: none;
  }
  .device-tablet {
    width: 82%;
    padding: 1.5%;
    border-radius: 3.2% / 4.5%;
    --reel-radius: 1.75% / 2.5%;
  }
  .device-phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 24%;
    padding: 0.9%;
    border-radius: 15% / 7.2%;
    --reel-radius: 12.4% / 5.7%;
  }
  /* The camera, in the room the phone's own layout leaves over its header. */
  .device-phone::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: 3%;
    left: 50%;
    width: 27%;
    height: 3.2%;
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
  }

  /* The flip-through. A leaf turns about its inner edge, and carries a
     page on each face. */
  .flip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    outline: none;
  }
  .flip:focus-visible .book {
    outline: 2px solid var(--accent);
    outline-offset: 8px;
  }
  .book {
    --leaf-w: min(348px, 42vw);
    --leaf-h: calc(var(--leaf-w) * 850 / 550);
    position: relative;
    width: calc(var(--leaf-w) * 2);
    height: var(--leaf-h);
    perspective: 2600px;
